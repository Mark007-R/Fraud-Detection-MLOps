# Sentinel telemetry stack — Day 4 Phase 3.
# Copy to .env (gitignored) before `docker compose up`.

POSTGRES_USER=sentinel
POSTGRES_PASSWORD=sentinel
POSTGRES_DB=sentinel_telemetry
POSTGRES_PORT=5432

# Used by the FastAPI app container.
API_PORT=8000

# Set the URL the FastAPI app talks to. On the host: localhost. In compose: postgres.
SENTINEL_DATABASE_URL=postgresql+psycopg2://sentinel:sentinel@localhost:5432/sentinel_telemetry

# Disable shadow in environments without a populated MLflow registry.
SENTINEL_DISABLE_SHADOW=1

# Decision threshold for the binary label cutoff.
SENTINEL_DECISION_THRESHOLD=0.5
